{
  "name": "annivgame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "build": "npm run typecheck && npm run check:content && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": { "phaser": "4.2.1" },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "engines": { "node": ">=22.12.0" }
}
